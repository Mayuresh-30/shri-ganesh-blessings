{
  "name": "shri-ganesh-blessings",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "server": "npm run start --workspace backend",
    "build": "npm run build --workspace frontend",
    "dev:full": "concurrently \"npm run dev\" \"npm run server\"",
    "lint": "npm run lint --workspace frontend",
    "test": "npm run test --workspace frontend -- --run",
    "test:ui": "npm run test:ui --workspace frontend",
    "coverage": "npm run coverage --workspace frontend",
    "preview": "npm run preview --workspace frontend"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
